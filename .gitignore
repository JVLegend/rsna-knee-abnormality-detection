# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Test, lint and notebook artefacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# macOS / editor
.DS_Store
.vscode/
.idea/

# Kaggle credentials and local tooling
.kaggle/
kaggle.json

# Competition data: never commit DICOMs or downloaded CSVs
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.dcm
*.dicom
*.nii
*.nii.gz
*.zip

# Model weights and large local artefacts
models/*
!models/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Generated reports and submissions
reports/*
!reports/.gitkeep
submissions/*
!submissions/.gitkeep

# Temporary files
tmp/
temp/
*.log
